# homebase configuration. Copy to .env and fill in. Never commit .env.

# --- Intelligence (required) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
LANGGRAPH_URL=http://127.0.0.1:8080
# Host/port the intelligence/ service itself binds to (run.sh reads these directly).
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=8080
LOG_LEVEL=INFO

# --- Paths / tools ---
HOMEBASE_ROOT=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
PYTHON_BIN=python3

# --- Dictation seam ---
# vowen | wisprflow | file   (file = you drop transcript.json into the session dir)
DICTATION_PROVIDER=file
VOWEN_HISTORY_PATH=
WISPRFLOW_HISTORY_PATH=

# --- Recorder seam ---
# screen-studio | file   (file = you drop the recording MP4 into the session dir)
RECORDER=file
SCREEN_STUDIO_DIR=

# --- Analysis context ---
# Path to your product's context_config (zones + prompt). See context/example-webapp.json
CONTEXT_CONFIG=context/example-webapp.json
